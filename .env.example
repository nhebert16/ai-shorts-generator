# ── Required ─────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-key

# ── Branding ─────────────────────────────────────────────
CHANNEL_NAME=Your Channel Name

# ── Narration (Microsoft Edge TTS — free, no key) ───────
EDGE_TTS_VOICE=en-US-GuyNeural
EDGE_TTS_RATE=+30%
WHISPER_MODEL=base          # tiny | base | small

# ── Paths / mix ──────────────────────────────────────────
BACKGROUND_VIDEO_PATH=assets/background.mp4
FONT_PATH=assets/fonts/Montserrat-Bold.ttf
OUTPUT_DIR=output
MUSIC_VOLUME=0.4

# ── YouTube upload ───────────────────────────────────────
# Uses OAuth: put your Google Cloud OAuth client file at ./youtube_secrets.json.
# The first run opens a browser and saves ./youtube_token.json (git-ignored).

# ── Optional platforms (poster.py) ───────────────────────
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
